# ─── Experiment Raw Data & Logs ──────────────────────────────
# Ignore raw per-run CSVs and logs (can be thousands of files / gigabytes)
results/raw/*.csv
results/logs/
*.log
results/experiment_summary.csv

# Keep directories in git
!results/raw/.gitkeep
!results/aggregated/.gitkeep
!results/figures/.gitkeep
!results/logs/.gitkeep

